# Server settings for Vercel Functions. Never put server secrets in frontend code.
# Never prefix server secrets with VITE_. Leave unset for download-only preview.
# FAQ requires SITE_ORIGIN, both UPSTASH settings, and RATE_LIMIT_SECRET,
# plus approved FAQ answers in src/content.js. Optional AI matches paraphrases only.
# Inquiry delivery additionally requires the Turnstile and Resend settings below.
SITE_ORIGIN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use a private random secret of at least 32 bytes.
RATE_LIMIT_SECRET=
# Optional, server-only. Never use VITE_OPENAI_API_KEY.
OPENAI_API_KEY=
RESEND_API_KEY=
INQUIRY_FROM=
INQUIRY_TO=
