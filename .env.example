# Server settings for Vercel Functions. Never put server secrets in frontend code.
# Set both to use the Supabase inquiry transport. Never put an sb_secret_ key here
# as a publishable key. These are server-side; the existing form stays same-origin.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Contact inquiries are stored by the Supabase Edge Function. RATE_LIMIT_SECRET
# and SITE_ORIGIN must match on the server proxy and Edge Function. Supabase
# provides its database credential to the hosted function; never expose it here.
# See SUPABASE-CONTACT-SETUP.md. Never prefix server secrets with VITE_.
# FAQ requires SITE_ORIGIN, both UPSTASH settings, and RATE_LIMIT_SECRET,
# plus approved FAQ answers in src/content.js. Optional AI matches paraphrases only.
# Turnstile and Upstash remain optional settings for other server features; the
# contact database flow does not require them.
SITE_ORIGIN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use a private random secret of at least 32 bytes.
RATE_LIMIT_SECRET=
# Optional, server-only. Never use VITE_OPENAI_API_KEY.
OPENAI_API_KEY=
